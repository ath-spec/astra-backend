# Copy to .env and fill in. Never commit .env (it is gitignored).
# Secrets are shown blank here on purpose.

# --- Core -------------------------------------------------------------------
PORT=8080
DATABASE_URL=postgresql://user:pass@localhost:5432/astra?sslmode=disable
REDIS_URL=
FRONTEND_URL=

# --- Auth / crypto --------------------------------------------------------
JWT_SECRET=
RM_JWT_SECRET=
MASTER_INTERNAL_KEY=
APP_AUTH_TOKEN=
# When MASTER_INTERNAL_KEY is exactly 32 chars, GROQ_API_KEY (and other
# marked secrets) are treated as encrypted and decrypted on boot.

# --- Third-party keys ----------------------------------------------------
GROQ_API_KEY=
SARVAM_API_KEY=

# --- AWS -----------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Budget ML ---------------------------------------------------------
BUDGET_ML_BASE_URL=
BUDGET_ML_TOKEN=

# --- RM / ops toggles --------------------------------------------------
RM_OTP_DEV_CODE=
RM_SEED_ON_BOOT=
BUDGET_ROLLOVER_SCHEDULER=
DEBUG_VERBOSE_LOG=

# =========================================================================
# IDBI Atlas integration
# =========================================================================
# Every feature is gated by its own flag. With all flags unset the app runs
# byte-for-byte as it does today (mock / seeded data). Set a flag to "true"
# to switch that one feature to live IDBI data — the feature's logic,
# endpoints and response shapes do not change.
#
# The gateway is authorised purely by the caller's allow-listed egress IP;
# no key or token is sent. Calls only work from a whitelisted IP (or through
# the SSM/SOCKS proxy).

# Base URL. config.Load() falls back to the sandbox value if unset.
IDBI_BASE_URL=https://sandboxpocgatewayprod.idbi.bank.in

# Feature 1 — real account balances on the dashboard (365 / 394).
IDBI_ACCOUNTS_ENABLED=false

# Feature 2 — real transactions feed spend analytics & budgets (393 / AA 595).
# Swaps the analytics source from MockSource to PgSource; engine unchanged.
IDBI_SPEND_ENABLED=false

# Feature 3 — "My Loans" (391 / 402 / 538 payoff).
IDBI_LOANS_ENABLED=false

# Feature 4 — Account Aggregator consent flow (590 / 591 / 592 / 497 / 498 / 595).
IDBI_AA_ENABLED=false
# "stub" — skip the (dead) 592 browser redirect; confirm the consent from 591.
# "live" — return the real 592 URL and wait for the 497 CONSENT_APPROVED webhook.
IDBI_AA_REDIRECT_MODE=stub
IDBI_AA_CALLBACK_URL=                # only read in "live" mode
IDBI_AA_PRODUCT_ID=TEST             # falls back to "TEST" if unset
IDBI_AA_VUA_SUFFIX=@onemoney        # falls back to "@onemoney" if unset

# Feature 5 — RM-portal per-client credit-risk snapshot (442 / 402).
IDBI_RM_RISK_ENABLED=false

# Feature 6 — CKYC / PAN verification (415). Needs the caller identity below.
IDBI_KYC_ENABLED=false
IDBI_CKYC_PARENT_COMPANY=
IDBI_CKYC_API_TOKEN=
IDBI_CKYC_BRANCH_CODE=
IDBI_CKYC_SOURCE_SYSTEM=Finacle    # falls back to "Finacle" if unset

# Feature 7 — verify a staff EIN against HRMS (508) before issuing an RM login
# code. Additive: only withholds a code for an EIN HRMS positively rejects; an
# HRMS outage fails open. The RM login code itself stays local. The RM staff
# row's employee_code must be a real HRMS EIN (sandbox seeds 137075).
IDBI_HRMS_LOGIN_ENABLED=false

# Feature 8 — credit score. 408 is dead in the sandbox, so this runs on the
# mock source; the flag only exposes GET /api/v1/idbi/credit-score.
IDBI_CREDIT_SCORE_ENABLED=false
